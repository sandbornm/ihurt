# Demo works without a key. For Grok, set LLM_PROVIDER=grok and fill XAI_API_KEY.
LLM_PROVIDER=demo
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
# Web voice notes use ElevenLabs Scribe v2. See docs/VOICE.md for setup and key permissions.
# Keep the real key in local .env only. Set TRANSCRIPTION_PROVIDER=off to disable uploads.
TRANSCRIPTION_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5
XAI_API_KEY=
XAI_MODEL=grok-4.20-0309-non-reasoning
# Local inference: set LLM_PROVIDER=local and the exact name of an installed model.
# Ollama: http://127.0.0.1:11434/v1  |  LM Studio: http://127.0.0.1:1234/v1
LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LOCAL_MODEL=
LOCAL_API_KEY=local
# Disable only if your local server does not support response_format=json_object.
LOCAL_JSON_MODE=true
APP_ENV=development
# Setup creates this automatically. To replace it, generate with: uv run python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=
ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
DATABASE_PATH=data/ihurt.sqlite3
ACTIVITIES_PER_DAY=3
TURNS_PER_ACTIVITY=6
REQUESTS_PER_MINUTE=12
SESSIONS_PER_IP_PER_DAY=12
DAILY_BUDGET_USD=5.00
# Conservative reservations, retained even on provider failure. See README.
ANALYSIS_RESERVATION_USD=0.10
TRANSCRIPTION_RESERVATION_USD=0.03
MAX_AUDIO_SECONDS=60
MAX_AUDIO_BYTES=3000000
# Loopback development needs no Turnstile keys. ihurt.app uses the private hosting repo's Worker configuration.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
