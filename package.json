{
  "name": "ihurt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "dev:web": "vite --host 127.0.0.1",
    "build:wasm": "asc assembly/heat.ts --outFile public/heat.wasm --optimize --noAssert --runtime stub",
    "build": "npm run build:wasm && tsc -b && vite build && node scripts/offline-build.mjs",
    "typecheck": "tsc -b",
    "test": "uv run pytest -q",
    "preview": "vite preview --host 127.0.0.1",
    "setup": "node scripts/setup.mjs",
    "check": "npm run build && npm run test:unit && npm test",
    "format": "prettier --write src scripts assembly *.json *.ts .github",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "node scripts/browser-check.mjs",
    "dev:ai": "concurrently -k -n web,api \"vite --host 127.0.0.1\" \"uv run uvicorn backend.app:app --host 127.0.0.1 --port 8000 --reload --reload-include .env --no-proxy-headers\"",
    "start": "npm run build && vite preview --host 127.0.0.1 --port 5173 --strictPort",
    "setup:ai": "node scripts/setup-ai.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "lucide-react": "^0.577.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.183.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.183.0",
    "@vitejs/plugin-react": "^5.1.0",
    "assemblyscript": "^0.28.9",
    "concurrently": "^9.2.1",
    "playwright": "1.63.0",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
